# Neon development branch (pooled connection for the app)
DATABASE_URL=

# Managed Better Auth from the selected Neon branch
NEON_AUTH_BASE_URL=
# Generate a random value at least 32 characters long.
NEON_AUTH_COOKIE_SECRET=

# Comma-separated. These users become super admins (`admin` role) on sign-in.
CRM_ADMIN_EMAILS=
# Comma-separated Google accounts allowed to sign in even without a crm.users row.
# Admin emails are automatically allowed too. Org members (org_admin / org_user)
# can also sign in if an active crm.users row exists — they should NOT be listed
# in CRM_ADMIN_EMAILS.
CRM_ALLOWED_EMAILS=

# Server-only credential and audit label for Claude/AI API access.
CRM_AI_API_KEY=
CRM_AI_ACTOR_NAME=Claude

# Public OAuth 2.0 Web client ID for Gmail + Calendar (authorization-code + PKCE).
# This is not a secret. Authorized JavaScript origins and redirect URIs must include
# the CRM origin, plus {origin}/api/google/oauth/callback.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Server-only Google OAuth web client secret. Never expose this to the browser.
GOOGLE_CLIENT_SECRET=

# Optional override. Defaults to {request origin}/api/google/oauth/callback.
# Local: http://localhost:3001/api/google/oauth/callback
GOOGLE_OAUTH_REDIRECT_URI=

# 32-byte AES-256-GCM key for Google refresh/access tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GOOGLE_TOKEN_ENCRYPTION_KEY=
